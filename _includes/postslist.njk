{%- set posts = postslist | reverse %}
<div class="postlist">
{%- for post in posts %}
	{%- set postYear = post.date | readableDate("yyyy") %}
	{%- set prevYear = (posts[loop.index0 - 1].date | readableDate("yyyy")) if not loop.first else "" %}

	{%- if postYear != prevYear %}
		{%- if not loop.first %}
		</ul>
	</section>
		{% endif %}
	<section class="postlist-year">
		<h2 class="postlist-year-heading">{{ postYear }}</h2>
		<ul class="postlist-year-list">
	{%- endif %}
			<li class="postlist-item{% if post.url == url %} postlist-item-active{% endif %}">
				<a href="{{ post.url }}" class="postlist-link">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
				<small>{{post.date | readableDate("dd MMM") }}</small>
			</li>
{%- endfor %}
	</ul>
	</section>
</div>
